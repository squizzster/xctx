#!/usr/bin/env bash
set -euo pipefail

## Protocol boundary: this launcher only starts the xctx interface.
## Domain-pack behavior belongs behind configured refs and adapter entrypoints.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON:-python3}"
exec "$PYTHON_BIN" "$ROOT/bin/xctx" "$@"
